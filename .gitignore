*.csv
*.csv.sha256
*.csv.validacio.txt
.cadena-*/
*.part

# a safety net: no file of the data bundle, and nothing the inspection writes, is ever committed
/data/
*.mp4
*_atd.xml
*_atd.txt
*smart_tagging*
!*smart_tagging*.py
*homography*
*.html
INVENTARI.md
